# Optional. Render sets PORT automatically; local dev defaults to 8000.
# PORT=8000

# PostgreSQL connection string (required for backend).
# Local: postgresql://USER:PASSWORD@localhost:5432/DATABASE
# Render: use the Internal or External URL from your Render Postgres dashboard.
# If password contains @, encode as %40 (e.g. my@pass → my%40pass)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/whatsapp_clone

# Required. Use a long random string in production (e.g. openssl rand -hex 32).
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Optional. Backend allows any origin by default; set for stricter CORS if needed.
# FRONTEND_URL=http://localhost:3080
